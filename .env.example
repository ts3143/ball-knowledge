# Copy to .env and fill in. Never commit .env.

# Postgres connection for the pipeline. Local Supabase default (from `supabase status`):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Wikimedia requires contact info in the User-Agent of API clients
# (https://foundation.wikimedia.org/wiki/Policy:User-Agent_policy).
# An email address or a URL where you can be reached.
WIKIMEDIA_CONTACT=

# Connection for the Next.js app, as the least-privilege role bk_app (read by lib/db/client.ts only).
# Pick a password, put it here, then run `npm run db:app-role` once to set it on the role.
APP_DATABASE_URL=postgresql://bk_app:<password>@127.0.0.1:54322/postgres

# Supabase Auth, for anonymous sign-in (read by lib/auth only; server-only, never sent to the browser).
# Local values: API_URL and PUBLISHABLE_KEY from `supabase status -o env`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=<publishable key>
