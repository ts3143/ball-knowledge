# Copy to .env and fill in. Never commit .env.

# Postgres connection for the pipeline. Local Supabase default (from `supabase status`):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Wikimedia requires contact info in the User-Agent of API clients
# (https://foundation.wikimedia.org/wiki/Policy:User-Agent_policy).
# An email address or a URL where you can be reached.
WIKIMEDIA_CONTACT=
