# Humans linked to one club (or its squad items) as player (P54) whose stint could fall in
# scope: it ends in the window, or it has no end date. Undated and open-ended links are fetched
# whatever the birth year, because the German Wikipedia career table (dewiki.py) can date them.
# Deliberately a superset of the scope rules in extract.py, which are applied to full
# statement data afterwards.
SELECT DISTINCT ?person WHERE {
  VALUES ?target { $targets }
  ?person p:P54 ?st .
  ?st ps:P54 ?target .
  ?person wdt:P31 wd:Q5 .
  OPTIONAL { ?st pq:P582 ?e . }
  BIND(COALESCE(IF(isLiteral(?e), YEAR(?e), -1), -1) AS ?ey)
  FILTER(?ey >= $start_year || ?ey < 0)
}
